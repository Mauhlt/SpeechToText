.{
    .name = .stt,
    .version = "0.1.0",
    .fingerprint = 0xb5cd06cc48bd238b,
    .minimum_zig_version = "0.18.0-dev.1005+75d48dfff",
    // Pinned commits on GitHub. Build against local checkouts with
    // `zig build --fork=../Audio --fork=../TranslateNPU`.
    .dependencies = .{
        // Audio file decoding/encoding (WAV, MP3, QOA).
        .Audio = .{
            .url = "git+https://github.com/Mauhlt/Audio#ad1f59fdce29bccbaef7cfb9ff955124ee0af0bc",
            .hash = "Audio-0.0.0-WaiWyDWpBABEDQ1vB2s7A5qzyMLReP--rsAABPb43qZ5",
        },
        // QNN (Snapdragon NPU) bindings, generated from the QAIRT SDK
        // headers. Lazy: only the NPU engine (aarch64-windows, see
        // build.zig) fetches it, and only for a step that compiles it.
        .TranslateNPU = .{
            .url = "git+https://github.com/Mauhlt/TranslateNPU#1121651243d5ef0e46f2100037ac04b392665305",
            .hash = "translate_npu-0.1.0-Yrl2K1nkAAAAEcAPDdJUCzlFGRoKPsxHH46BJVUI8rYv",
            .lazy = true,
        },

        // Core ML: ML Program writer, host reference interpreter, runtime bindings
        // (iPhone / Mac). Lazy: fetched only for iOS / macOS targets or -Dcoreml.
        .TranslateCoreML = .{
            .url = "git+https://github.com/Mauhlt/TranslateCoreML#dfa822ae476bf05b98f65f9e0eff7bd2bff2b3da",
            .hash = "translate_coreml-0.1.0-92kNG2lzAwCUCIQc2bpY3QLSpBsToKPdQ96Noq5q8aJa",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "LICENSE",
        "THIRD_PARTY.md",
        "src",
        // No testdata: the package ships no audio. Tests generate theirs
        // (stt.testdata) or read an optional local speech sample.
    },
}
