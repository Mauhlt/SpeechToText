.{
    .name = .stt,
    .version = "0.1.0",
    .fingerprint = 0xb5cd06cc48bd238b,
    .minimum_zig_version = "0.18.0-dev.1005+75d48dfff",
    // Pinned commits on GitHub. Build against local checkouts with
    // `zig build --fork=../Audio --fork=../TranslateNPU`.
    .dependencies = .{
        // Audio file decoding/encoding (WAV, MP3, QOA).
        .Audio = .{
            .url = "git+https://github.com/Mauhlt/Audio#3371aecfe3969b385ef4ec5935c6ca926971016b",
            .hash = "Audio-0.0.0-WaiWyGroUADN5wFXgx_GHbPGErZqBlUSN9w7Is93pyzw",
        },
        // QNN (Snapdragon NPU) bindings, generated from the QAIRT SDK
        // headers. Lazy: only the NPU engine (aarch64-windows, see
        // build.zig) fetches it, and only for a step that compiles it.
        .TranslateNPU = .{
            .url = "git+https://github.com/Mauhlt/TranslateNPU#176954b48bf5250f4389b33b53a8d25a3b027bce",
            .hash = "translate_npu-0.1.0-Yrl2K5zPAADGrUdkzSog4Jp92Gpqn6O1OrPoww2uzZ8y",
            .lazy = true,
        },

        // Core ML: ML Program writer, host reference interpreter, runtime bindings
        // (iPhone / Mac). Lazy: fetched only for iOS / macOS targets or -Dcoreml.
        .TranslateCoreML = .{
            .url = "git+https://github.com/Mauhlt/TranslateCoreML#5d4a1f4d104aa5221357ad1da9538f80f0422d35",
            .hash = "translate_coreml-0.1.0-92kNGzZoAwBzbe7cN-JNFTznkZn3luJ24H8OZt5YVAFH",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        // testdata/hello.wav: packages' tests (Portal's speech tests) use it.
        "testdata",
    },
}
